{
  "name": "exam408-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run check:independence && node --test tests/*.test.mjs",
    "check:independence": "node ../scripts/check-independence.mjs",
    "type-check": "vue-tsc --noEmit",
    "build": "node ../scripts/update-frontend-notices.mjs && npm run type-check && vite build"
  },
  "dependencies": {
    "axios": "^1.12.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^3.0.3",
    "tdesign-icons-vue-next": "^0.4.1",
    "tdesign-vue-next": "^1.16.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.2.8"
  }
}
