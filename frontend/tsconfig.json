{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "jsx": "preserve",
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"], "skipLibCheck": true,
    "baseUrl": ".", "ignoreDeprecations": "6.0", "paths": {"@/*": ["src/*"]}
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
