# ============================================================
# 408 考研知识图谱智能问答系统 - 环境变量配置模板
# 复制为 .env 后按实际填写；不填任何 Key 时系统自动降级为本地演示模式
# ============================================================

# ---------- 三大 Provider 开关（可插拔，无需改代码） ----------
# 大模型: deepseek / huawei_maas / huawei_mindie / openai
LLM_PROVIDER=deepseek
# 知识图谱: auto / neo4j / huawei_ges / sample
GRAPH_PROVIDER=auto
# 语义理解: auto / llm / huawei_nlp / keyword
NLP_PROVIDER=auto

# ---------- 华为云通用配置（盘古/GES/NLP 共用） ----------
# 控制台获取：区域名、项目ID(我的凭证)、访问密钥 AK/SK
HUAWEI_REGION=cn-southwest-2
HUAWEI_PROJECT_ID=
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=

# ---------- 华为云 MaaS 盘古大模型（LLM_PROVIDER=huawei_maas 时生效） ----------
HUAWEI_MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1
HUAWEI_MAAS_API_KEY=
# 模型名以控制台「API 调用」显示为准，如 openPangu / deepseek-v4.1-flash
HUAWEI_MAAS_MODEL=openPangu

# ---------- 昇腾 MindIE 本地推理（LLM_PROVIDER=huawei_mindie 时生效） ----------
# 需在昇腾服务器上部署 MindIE，无需 API Key
HUAWEI_MINDIE_BASE_URL=http://localhost:1025/v1
HUAWEI_MINDIE_MODEL=openPangu

# ---------- 华为云 GES 图引擎（GRAPH_PROVIDER=huawei_ges 时生效） ----------
# 图 ID/名称、图访问地址（SERVER_URL，图详情的公网/内网访问地址）
HUAWEI_GES_GRAPH_ID=
HUAWEI_GES_ENDPOINT=
HUAWEI_GES_PROJECT_ID=

# ---------- 华为云 NLP 自然语言处理（NLP_PROVIDER=huawei_nlp 时生效） ----------
# 需先在控制台开通 NLP 服务；默认北京四
HUAWEI_NLP_ENDPOINT=nlp-ext.cn-north-4.myhuaweicloud.com
HUAWEI_NLP_PROJECT_ID=

# ---------- 其他大模型（DeepSeek / OpenAI 兼容） ----------
# 选择 deepseek 时把 Key 填到 API_KEY 区域；选择 openai 时填下面两项
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ---------- Neo4j 配置（GRAPH_PROVIDER=neo4j 时生效） ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ============================================================
# API Key 区域（兼容旧配置，DeepSeek 等直接填这里）
# ============================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================================
# 其他配置（一般无需修改）
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_DIMENSION=512
CACHE_TTL=86400
CACHE_MAX_ENTRIES=500
MAX_HISTORY_ROUNDS=5
KNOWLEDGE_VERSION=v1.0
