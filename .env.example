# 配置交接说明
# 首次使用：复制本文件为 .env，再填写密钥；已有 .env 不要覆盖，不要公开真实密钥。
# Docker Compose 会将 .env 注入 API/worker；直接启动 Go/Python 不会自动读取本文件，
# 需要先在对应终端设置环境变量。两个 Python 服务仍须单独启动，详见 services 下的 README。
# 本模板启用的是云端嵌入示例；复现当前本地 text2vec 方案请替换下方 EMBEDDING_* 四项。

# 一、基础配置
# 环境标记：当前后端未根据 APP_ENV 切换运行行为。
APP_ENV=development
# API 监听地址；Compose 固定覆盖为 :8080。
HTTP_ADDR=:8080
# 宿主机直接运行 Go 时使用的数据库地址；Compose 固定覆盖为 postgres 服务地址。
# 当前 Compose 的数据库名、用户和密码均为 exam408；改凭据时须同步修改 compose.yaml。
DATABASE_URL=postgres://exam408:exam408@localhost:5432/exam408?sslmode=disable
# Redis 连接配置；Compose 为 API 固定覆盖地址为 redis:6379，默认 Redis 没有密码。
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# 必填：改为至少 32 个字符的随机密钥，保留 change-this 占位值会被拒绝启动。
# API 与 worker 使用同一个值；修改密钥后旧登录令牌会失效。
JWT_SECRET=change-this-to-at-least-32-random-characters
# 登录令牌有效期，采用 Go duration 格式，例如 24h、168h。
JWT_TTL=24h
# 首次管理员初始化用的一次性令牌：设置为至少 32 位随机值，成功初始化后可从 .env 删除并重启。
# 仅可提升已注册账号；若管理员已存在，接口会关闭。不要提交真实令牌。
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-random-bootstrap-token
# 原文件存储目录；Compose 固定覆盖为 /data/uploads，并挂载 uploads 数据卷。
STORAGE_ROOT=./storage/uploads
# 单文件上传上限（MiB），默认200，支持1–512；Nginx传输上限513 MiB。
# 独立Python解析服务若启用，需同步设置其MAX_UPLOAD_MB。
MAX_UPLOAD_MB=200

# 二、文本大模型：用于 AI 答疑、参考答案与练习生成，调用可能消耗服务商额度。
# 以下仅为兼容接口的填写示例；模型名和地址须按接手人实际可用的服务商配置。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 三、嵌入模型：用于文档向量化和问题检索，地址、模型、维度必须配套。
# 方案 A：云端示例，需要填写服务商 Key，调用可能收费。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# 方案 B：当前使用的本地 text2vec；将上面四项替换为下列配置，不要重复定义同名变量。
# EMBEDDING_BASE_URL=http://host.docker.internal:8090/v1
# EMBEDDING_API_KEY=replace-with-your-local-service-token
# EMBEDDING_MODEL=text2vec-base-chinese-windowed-v1
# EMBEDDING_DIMENSION=768
# 后端直接在宿主机运行时，将 host.docker.internal 改为 127.0.0.1。
# 本地服务另一个终端中设置 LOCAL_EMBEDDING_API_KEY，与上面的 EMBEDDING_API_KEY 一致。
# 权重位置通过 server.py --model-path 指定，不是环境变量；必须提供完整模型目录。
# 本地嵌入使用 CPU，不消耗云端 API 额度。安装与启动见 services/local_embedding/README.md。
# 切换嵌入端点、模型或维度会改变向量空间，旧资料可能需要重新处理。

# 四、检索与演示模式
# 每次检索选取的片段数量。
RAG_TOP_K=5
# 正常 AI 答疑要求 LLM 和 Embedding 均已配置；本地嵌入令牌也须填写。
# true 为显式演示模式：使用本地演示向量和片段预览，不调用外部回答/嵌入模型。
# 演示模式的向量不同于上面的 text2vec 模型；不能作为真实 AI 效果验收。
AI_DEMO_MODE=false
# 显式开启资料图谱候选抽取；需要正常模型模式及 LLM 配置，可能产生模型费用。
# 未开启时仍执行权威目录匹配；模型候选只有通过原文证据校验才入库。
GRAPH_EXTRACTION_ENABLED=false
# 相似度门槛，范围 (0,1]；配合文本相关性检查，需按资料和模型评测调整。
RAG_MIN_SCORE=0.35
# 允许的前端来源，多个地址用英文逗号分隔；远程访问时填写实际前端来源。
CORS_ORIGINS=http://localhost:5173

# 五、PDF/DOCX 本地解析：文字、版面、表格、公式识别，不调用云端大模型。
# Docker 中 API/worker 访问宿主机 8091；直接运行 Go 时改为 http://127.0.0.1:8091。
# 留空会使用内置基础解析，不能视为具备扫描件 OCR 和完整结构识别。
DOCUMENT_PARSER_URL=http://host.docker.internal:8091
# 启用远程解析服务时填写随机令牌；须与 Python 服务进程的 PARSER_TOKEN 一致。
DOCUMENT_PARSER_TOKEN=
# 解析行为或模型版本改变时更新此标识，以便检查点复用时区分版本；密钥不参与版本指纹。
DOCUMENT_PARSER_VERSION=408-parser-v2
# 以下是 Python 解析服务终端的环境变量示例，仅写入根目录 .env 不会自动传给该进程：
# $env:PARSER_TOKEN = '与 DOCUMENT_PARSER_TOKEN 相同的令牌'
# $env:PARSER_DEVICE = 'cpu'
# $env:PADDLE_PDX_CACHE_HOME = Join-Path (Get-Location) '.cache/paddle'
# $env:PADDLE_PDX_MODEL_SOURCE = 'BOS'
# $env:DISABLE_MODEL_SOURCE_CHECK = 'True'
# 请在项目根目录按 services/document_parser/README.md 启动；模型默认首次使用时加载。

# 六、可选视觉模型：用于理解题目/资料中的图像，不是 OCR 服务的配置。
# 当前可以全部留空；如需图意理解，三项须配套填写，调用可能收费。
# 地址示例：https://your-provider.example/v1（替换成实际 OpenAI 兼容接口）。
VISION_BASE_URL=
VISION_API_KEY=
# 填写服务商实际支持图像输入的模型名，不能仅填写普通文本模型。
VISION_MODEL=

# 七、启动角色与前端（按需设置，默认无需取消注释）
# APP_ROLE=worker
# 仅手动启动文档 worker 时设置 APP_ROLE=worker；普通 API 进程不设置此值。
# Compose 已为 worker 单独设置，不要在公共 .env 中启用，否则 API 也会进入 worker 模式。
# APP_ENV_FILE=.env
# Compose 可用此变量指定 API/worker 的 env_file，但它不会替代 Compose 的插值来源。
# 使用其他配置文件时，应同时明确 docker compose --env-file <文件> 的配置来源。
# VITE_API_BASE_URL=/api/v1
# 前端可选项：放在 frontend/.env.local 中，由 Vite 开发/构建时读取。
# 根目录 .env 不会自动传给前端；当前 Compose 未提供此项构建参数。
# 默认同源 /api/v1 已由 Vite/nginx 代理，通常无需设置。VITE_* 中不得放入密钥。

# 八、开发测试（非正常运行必填项，仅在测试终端设置）
# TEST_DATABASE_URL=postgres://exam408:exam408@localhost:5432/exam408?sslmode=disable
# 数据库集成测试连接入口，账号需具备创建隔离测试库的权限；详见 docs/ENGINEERING_FOUNDATION.md。
# RUN_PRESSURE_TEST=1
# BROWSER_ACCEPTANCE=1
# BROWSER_FIXTURE_PATH=C:/path/to/synthetic-fixture.pdf
# BROWSER_STOP_FILE=C:/path/to/browser-stop-file
# 压力/浏览器验收为显式开关；请使用合成资料，具体流程见 docs/TASKS_3_5_IMPLEMENTATION.md。

# 本地知识库处理无需大模型API。auto在未填写向量Key时使用本地词法向量；remote使用服务商。
EMBEDDING_MODE=auto
# builtin使用Docker内置PDF文字提取/Tesseract OCR；remote显式使用独立结构化服务。
DOCUMENT_PARSER_MODE=builtin
# 默认普通用户只读公共知识库；旧个人数据保留，不删除。
PERSONAL_KB_ENABLED=false

# 扫描教材OCR可耗时较长，后台任务总时限，范围1m–4h；不影响上传后立即返回。
DOCUMENT_JOB_TIMEOUT=2h
